  "exercise": {
    "title": "إنفاق كل عميل",
    "prompt": [
      "لديك قائمة معاملات، وكل معاملة قاموس فيه اسم العميل والمبلغ."
    ],
    "requirements": [
      "`spend`: قاموس مفاتيحه أسماء العملاء وقيمه مجموع إنفاق كل عميل.",
      "`top_customer`: اسم العميل الأعلى إنفاقاً.",
      "`vip`: قائمة مرتبة أبجدياً بأسماء العملاء الذين تجاوز إنفاقهم 500."
    ],
    "starter_code": [
      "transactions = [",
      "    {\"customer\": \"ليان\", \"amount\": 250},",
      "    {\"customer\": \"ماجد\", \"amount\": 120},",
      "    {\"customer\": \"ليان\", \"amount\": 400},",
      "    {\"customer\": \"عبير\", \"amount\": 610},",
      "    {\"customer\": \"ماجد\", \"amount\": 90},",
      "    {\"customer\": \"عبير\", \"amount\": 35},",
      "]",
      "",
      "spend = {}",
      "# اكتب الحل هنا"
    ],
    "tests": [
      "assert spend == {\"ليان\": 650, \"ماجد\": 210, \"عبير\": 645}, f\"spend غير صحيح: {spend}\"",
      "assert top_customer == \"ليان\", f\"العميل الأعلى إنفاقاً هو ليان (650)، والموجود {top_customer!r}\"",
      "assert vip == sorted([\"ليان\", \"عبير\"]), f\"vip يجب أن تكون {sorted(['ليان', 'عبير'])}، والموجود {vip}\""
    ],
    "hints": [
      "نمط التجميع: `spend[name] = spend.get(name, 0) + t[\"amount\"]`.",
      "أكبر مفتاح حسب قيمته: `max(spend, key=spend.get)`.",
      "مرّ على `spend.items()` وأضف الاسم إلى `vip` إذا تجاوز 500، ثم رتّب."
    ],
    "solution": [
      "transactions = [",
      "    {\"customer\": \"ليان\", \"amount\": 250},",
      "    {\"customer\": \"ماجد\", \"amount\": 120},",
      "    {\"customer\": \"ليان\", \"amount\": 400},",
      "    {\"customer\": \"عبير\", \"amount\": 610},",
      "    {\"customer\": \"ماجد\", \"amount\": 90},",
      "    {\"customer\": \"عبير\", \"amount\": 35},",
      "]",
      "",
      "spend = {}",
      "for t in transactions:",
      "    name = t[\"customer\"]",
      "    spend[name] = spend.get(name, 0) + t[\"amount\"]",
      "",
      "top_customer = max(spend, key=spend.get)",
      "",
      "vip = []",
      "for name, total in spend.items():",
      "    if total > 500:",
      "        vip.append(name)",
      "vip = sorted(vip)",
      "",
      "print(spend)",
      "print(top_customer, vip)"
    ]
  },
