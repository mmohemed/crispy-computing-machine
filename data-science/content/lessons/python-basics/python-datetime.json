      "`inactive`: عدد العملاء الذين مضى على آخر شراء لهم أكثر من 90 يوماً.",
      "`busiest_month`: رقم الشهر الذي تكرر أكثر في التواريخ."
    ],
    "starter_code": [
      "from datetime import date, datetime",
      "",
      "analysis_date = date(2025, 12, 31)",
      "raw_dates = [\"15/11/2025\", \"03/03/2025\", \"28/11/2025\", \"20/06/2025\", \"30/11/2025\", \"01/12/2025\"]",
      "",
      "# اكتب الحل هنا"
    ],
    "tests": [
      "from datetime import date as _d",
      "assert parsed == [_d(2025, 11, 15), _d(2025, 3, 3), _d(2025, 11, 28), _d(2025, 6, 20), _d(2025, 11, 30), _d(2025, 12, 1)], f\"parsed غير صحيحة: {parsed}\"",
      "assert recency == [46, 303, 33, 194, 31, 30], f\"recency غير صحيحة: {recency}\"",
      "assert inactive == 2, f\"inactive يجب أن يكون 2، والموجود {inactive}\"",
      "assert busiest_month == 11, f\"busiest_month يجب أن يكون 11، والموجود {busiest_month}\""
    ],
    "hints": [
      "`datetime.strptime(text, \"%d/%m/%Y\").date()` تعطي `date` بدون وقت.",
      "`(analysis_date - d).days` لعدد الأيام.",
      "للشهر الأكثر تكراراً: `Counter(...).most_common(1)[0][0]`."
    ],
    "solution": [
      "from datetime import date, datetime",
      "from collections import Counter",
      "",
      "analysis_date = date(2025, 12, 31)",
      "raw_dates = [\"15/11/2025\", \"03/03/2025\", \"28/11/2025\", \"20/06/2025\", \"30/11/2025\", \"01/12/2025\"]",
      "",
      "parsed = [datetime.strptime(d, \"%d/%m/%Y\").date() for d in raw_dates]",
      "recency = [(analysis_date - d).days for d in parsed]",
      "inactive = sum(1 for r in recency if r > 90)",
      "busiest_month = Counter(d.month for d in parsed).most_common(1)[0][0]",
      "",
      "print(recency, inactive, busiest_month)"
    ]
  },
