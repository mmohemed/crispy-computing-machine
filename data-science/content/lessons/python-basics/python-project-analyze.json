    "solution": [
      "import csv",
      "",
      "def load_orders(path):",
      "    orders = []",
      "    with open(path, encoding=\"utf-8\", newline=\"\") as f:",
      "        for row in csv.DictReader(f):",
      "            price = int(row[\"unit_price\"])",
      "            qty = int(row[\"quantity\"])",
      "            discount = float(row[\"discount\"])",
      "            orders.append({",
      "                \"order_id\": row[\"order_id\"],",
      "                \"date\": row[\"order_date\"],",
      "                \"month\": int(row[\"order_date\"][5:7]),",
      "                \"city\": row[\"city\"],",
      "                \"category\": row[\"category\"],",
      "                \"product\": row[\"product\"],",
      "                \"qty\": qty,",
      "                \"revenue\": round(price * qty * (1 - discount), 2),",
      "                \"rating\": int(row[\"rating\"]) if row[\"rating\"] else None,",
      "            })",
      "    return orders",
      "",
      "def revenue_by(orders, key):",
      "    totals = {}",
      "    for o in orders:",
      "        totals[o[key]] = totals.get(o[key], 0) + o[\"revenue\"]",
      "    return {k: round(v, 2) for k, v in totals.items()}",
      "",
      "",
      "def top_n(totals, n=3):",
      "    return sorted(totals.items(), key=lambda item: item[1], reverse=True)[:n]",
      "",
      "",
      "orders = load_orders(\"store_sales.csv\")",
      "",
      "orders_count = {}",
      "for o in orders:",
      "    orders_count[o[\"city\"]] = orders_count.get(o[\"city\"], 0) + 1",
      "",
      "city_revenue = revenue_by(orders, \"city\")",
      "city_aov = {city: round(city_revenue[city] / orders_count[city], 2) for city in orders_count}",
      "top_aov_city = max(city_aov, key=city_aov.get)",
      "",
      "for city, value in top_n(city_aov, 6):",
      "    print(city, value)"
    ]
  },
