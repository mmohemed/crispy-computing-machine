    {
      "type": "example",
      "title": "ترتيب بعمود وبعدة أعمدة",
      "code": [
        "import pandas as pd",
        "",
        "df = pd.read_csv(\"store_sales.csv\")",
        "df[\"revenue\"] = df[\"unit_price\"] * df[\"quantity\"] * (1 - df[\"discount\"])",
        "cols = [\"order_id\", \"city\", \"product\", \"revenue\"]",
