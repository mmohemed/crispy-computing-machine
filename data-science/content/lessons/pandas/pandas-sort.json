    {
      "type": "example",
      "title": "nlargest و nsmallest و reset_index",
      "code": [
        "import pandas as pd",
        "",
        "df = pd.read_csv(\"store_sales.csv\")",
        "",
        "top = df.nlargest(3, \"unit_price\")[[\"product\", \"unit_price\"]]",
        "print(top)",
        "",
        "cheapest = df.nsmallest(3, [\"unit_price\", \"quantity\"])[[\"product\", \"unit_price\", \"quantity\"]]",
        "print(cheapest.reset_index(drop=True))"
      ],
      "explanation": [
        {
          "code": "nlargest(3, \"unit_price\")",
          "text": "أعلى 3 صفوف حسب السعر. عند التساوي تُؤخذ الأسبق في الجدول."
        },
        {
          "code": "nsmallest(3, [\"unit_price\", \"quantity\"])",
          "text": "الأرخص، ثم الأقل كمية عند تساوي السعر."
        },
        {
          "code": "reset_index(drop=True)",
          "text": "ترقيم جديد 0 و 1 و 2، و `drop=True` لا يحتفظ بالفهرس القديم كعمود."
        }
      ],
      "expected_output": [
        "      product  unit_price",
        "28  ساعة ذكية         399",
        "30  ساعة ذكية         399",
        "78  ساعة ذكية         399",
        "  product  unit_price  quantity",
        "0   رواية          45         1",
        "1   رواية          45         1",
        "2   رواية          45         1"
      ]
    },
    {
      "type": "example",
      "title": "القيم المفقودة والترتيب حسب الفهرس",
      "code": [
        "import pandas as pd",
        "",
        "df = pd.read_csv(\"store_sales.csv\", nrows=6)[[\"order_id\", \"rating\"]]",
        "",
        "print(df.sort_values(\"rating\"))",
        "print(df.sort_values(\"rating\", na_position=\"first\").head(2))",
        "",
        "shuffled = df.sample(frac=1, random_state=3)",
        "print(shuffled.index.tolist(), shuffled.sort_index().index.tolist())"
      ],
      "explanation": [
        {
          "code": "sort_values(\"rating\")",
          "text": "القيم المفقودة في النهاية افتراضياً."
        },
        {
          "code": "na_position=\"first\"",
          "text": "المفقودة أولاً، مفيد لمراجعتها."
        },
        {
          "code": "sample(frac=1)",
          "text": "`frac=1` تعني عينة بحجم الجدول كله، أي خلط الصفوف. ثم `sort_index` تعيد الترتيب الأصلي."
        }
      ],
      "expected_output": [
        "    order_id  rating",
