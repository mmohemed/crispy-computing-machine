  "exercise": {
    "title": "تقرير الفحص الأولي",
    "prompt": [
      "افحص `store_sales.csv` وخزّن النتائج في متغيرات:"
    ],
    "requirements": [
      "`n_rows, n_cols`: أبعاد الجدول.",
      "`missing`: قاموس لكل عمود فيه قيم مفقودة ← عددها (أعداد `int`).",
      "`median_price` و `mean_price`: وسيط ومتوسط `unit_price` كـ `float` مقربين لمنزلتين.",
      "`most_common_product`: المنتج الأكثر تكراراً.",
      "`n_products`: عدد المنتجات المختلفة كـ `int`."
    ],
    "starter_code": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\")",
      "",
      "# اكتب الحل هنا"
    ],
    "tests": [
      "import pandas as _pd",
      "_df = _pd.read_csv(\"store_sales.csv\")",
      "assert (n_rows, n_cols) == _df.shape, \"الأبعاد غير صحيحة\"",
      "_m = {k: int(v) for k, v in _df.isna().sum().items() if v > 0}",
      "assert missing == _m, f\"missing يجب أن يكون {_m}، والموجود {missing}\"",
      "assert median_price == round(float(_df[\"unit_price\"].median()), 2), \"median_price غير صحيح\"",
      "assert mean_price == round(float(_df[\"unit_price\"].mean()), 2), \"mean_price غير صحيح\"",
      "assert most_common_product == _df[\"product\"].value_counts().idxmax(), \"most_common_product غير صحيح\"",
      "assert n_products == _df[\"product\"].nunique() and isinstance(n_products, int), \"n_products غير صحيح\""
    ],
    "hints": [
      "`df.isna().sum()` Series؛ حوّلها لقاموس مع تصفية القيم الأكبر من صفر.",
      "`df[\"unit_price\"].median()` و `.mean()`.",
      "`value_counts().idxmax()` و `nunique()`."
    ],
    "solution": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\")",
      "",
      "n_rows, n_cols = df.shape",
      "na = df.isna().sum()",
      "missing = {col: int(count) for col, count in na.items() if count > 0}",
      "median_price = round(float(df[\"unit_price\"].median()), 2)",
      "mean_price = round(float(df[\"unit_price\"].mean()), 2)",
      "most_common_product = df[\"product\"].value_counts().idxmax()",
      "n_products = int(df[\"product\"].nunique())",
      "",
      "print(n_rows, n_cols, missing)",
      "print(median_price, mean_price, most_common_product, n_products)"
    ]
  },
