  "exercise": {
    "title": "استعلامات على الطلبات",
    "prompt": [
      "اقرأ الملف مع `order_id` كفهرس، ثم:"
    ],
    "requirements": [
      "`city_of_10100`: مدينة الطلب `ORD-10100` باستخدام `loc`.",
      "`first_five`: أول 5 صفوف والأعمدة `product` و `unit_price` باستخدام `iloc` (مواقعهما في الجدول بعد جعل `order_id` فهرساً: 3 و 4).",
      "`jeddah_books`: صفوف مدينة `جدة` وفئة `كتب` مع الأعمدة `order_date` و `product` و `quantity`، باستخدام `loc` مع شرط.",
      "أضف عموداً `size` قيمته `\"كبير\"` للطلبات التي كميتها 3 فأكثر و `\"عادي\"` لغيرها، باستخدام `loc` مرتين."
    ],
    "starter_code": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\", index_col=\"order_id\")",
      "",
      "# اكتب الحل هنا"
    ],
    "tests": [
      "import pandas as _pd",
      "_d = _pd.read_csv(\"store_sales.csv\", index_col=\"order_id\")",
      "assert city_of_10100 == _d.loc[\"ORD-10100\", \"city\"], \"city_of_10100 غير صحيحة\"",
      "assert first_five.shape == (5, 2) and list(first_five.columns) == [\"product\", \"unit_price\"], f\"first_five غير صحيحة: {first_five.shape}, {list(first_five.columns)}\"",
      "_exp = _d.loc[(_d[\"city\"] == \"جدة\") & (_d[\"category\"] == \"كتب\"), [\"order_date\", \"product\", \"quantity\"]]",
      "assert jeddah_books.equals(_exp), f\"jeddah_books غير صحيحة (المتوقع {len(_exp)} صفاً)\"",
      "assert set(df[\"size\"].unique()) == {\"كبير\", \"عادي\"}, \"size يجب أن تحتوي كبير و عادي فقط\"",
      "assert (df.loc[df[\"quantity\"] >= 3, \"size\"] == \"كبير\").all() and (df.loc[df[\"quantity\"] < 3, \"size\"] == \"عادي\").all(), \"قيم size غير صحيحة\""
    ],
    "hints": [
      "بعد `index_col=\"order_id\"` تبدأ المواقع من `order_date` = 0، فالمنتج 3 والسعر 4.",
      "الشرط المركب: `(df[\"city\"] == \"جدة\") & (df[\"category\"] == \"كتب\")`.",
      "`df.loc[df[\"quantity\"] >= 3, \"size\"] = \"كبير\"`."
    ],
    "solution": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\", index_col=\"order_id\")",
      "",
      "city_of_10100 = df.loc[\"ORD-10100\", \"city\"]",
      "first_five = df.iloc[:5, [3, 4]]",
      "jeddah_books = df.loc[(df[\"city\"] == \"جدة\") & (df[\"category\"] == \"كتب\"), [\"order_date\", \"product\", \"quantity\"]]",
      "df.loc[df[\"quantity\"] >= 3, \"size\"] = \"كبير\"",
      "df.loc[df[\"quantity\"] < 3, \"size\"] = \"عادي\"",
      "",
      "print(city_of_10100)",
      "print(first_five)",
      "print(len(jeddah_books), df[\"size\"].value_counts().to_dict())"
    ]
  },
