  "exercise": {
    "title": "تحليل عمود الفئات",
    "prompt": [
      "من ملف `store_sales.csv`:"
    ],
    "requirements": [
      "`categories`: عمود `category` كـ Series.",
      "`counts`: عدد الطلبات لكل فئة بـ `value_counts`.",
      "`top_category`: الفئة الأكثر طلباً (تسمية أول عنصر في `counts`، استخدم `idxmax`).",
      "`share_books`: نسبة طلبات فئة `كتب` من كل الطلبات كـ `float` مقرب لثلاث منازل."
    ],
    "starter_code": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\")",
      "",
      "# اكتب الحل هنا"
    ],
    "tests": [
      "import pandas as _pd",
      "_df = _pd.read_csv(\"store_sales.csv\")",
      "assert isinstance(categories, _pd.Series) and len(categories) == len(_df), \"categories يجب أن تكون عمود category كاملاً\"",
      "assert counts.to_dict() == _df[\"category\"].value_counts().to_dict(), \"counts غير صحيحة\"",
      "assert top_category == _df[\"category\"].value_counts().idxmax(), f\"top_category غير صحيحة: {top_category}\"",
      "_exp = round(float((_df[\"category\"] == \"كتب\").mean()), 3)",
      "assert isinstance(share_books, float) and share_books == _exp, f\"share_books يجب أن تكون {_exp}، والموجود {share_books}\""
    ],
    "hints": [
      "`df[\"category\"]` تعطي Series.",
      "`counts.idxmax()` تسمية أكبر قيمة.",
      "نسبة الكتب: `counts[\"كتب\"] / len(categories)`، أو `(categories == \"كتب\").mean()`."
    ],
    "solution": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\")",
      "",
      "categories = df[\"category\"]",
      "counts = categories.value_counts()",
      "top_category = counts.idxmax()",
      "share_books = round(float(counts[\"كتب\"] / len(categories)), 3)",
      "",
      "print(counts)",
      "print(top_category, share_books)"
    ]
  },
