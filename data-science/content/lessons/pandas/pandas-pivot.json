    "solution": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\")",
      "df[\"revenue\"] = df[\"unit_price\"] * df[\"quantity\"] * (1 - df[\"discount\"])",
      "",
      "rating_pt = df.pivot_table(index=\"category\", columns=\"customer_type\",",
      "                           values=\"rating\", aggfunc=\"mean\").round(2)",
      "worst_cell = rating_pt.stack().idxmin()",
      "new_share = pd.crosstab(df[\"category\"], df[\"customer_type\"], normalize=\"index\").round(3)",
      "",
      "print(rating_pt)",
      "print(worst_cell)",
      "print(new_share)"
