    "tests": [
      "_g = df.groupby",
      "assert orders_by_payment.to_dict() == df.groupby(\"payment_method\").size().to_dict(), \"orders_by_payment غير صحيحة\"",
      "assert avg_rating_by_cat.to_dict() == df.groupby(\"category\")[\"rating\"].mean().round(2).to_dict(), \"avg_rating_by_cat غير صحيحة\"",
      "assert top_product == df.groupby(\"product\")[\"revenue\"].sum().idxmax(), \"top_product غير صحيح\"",
      "_exp = (df[\"customer_type\"] == \"عائد\").groupby(df[\"city\"]).mean().round(3)",
      "assert returning_share.to_dict() == _exp.to_dict(), \"returning_share غير صحيحة\""
    ],
    "hints": [
      "عدد الطلبات: `size()` وليس `count()`.",
