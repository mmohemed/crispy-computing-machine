      "أنشئ عموداً منطقياً للعميل العائد، ثم متوسطه لكل مدينة."
    ],
    "solution": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\")",
      "df[\"revenue\"] = df[\"unit_price\"] * df[\"quantity\"] * (1 - df[\"discount\"])",
      "",
      "orders_by_payment = df.groupby(\"payment_method\").size()",
      "avg_rating_by_cat = df.groupby(\"category\")[\"rating\"].mean().round(2)",
      "top_product = df.groupby(\"product\")[\"revenue\"].sum().idxmax()",
      "",
      "df[\"is_returning\"] = df[\"customer_type\"] == \"عائد\"",
      "returning_share = df.groupby(\"city\")[\"is_returning\"].mean().round(3)",
      "",
      "print(orders_by_payment)",
      "print(avg_rating_by_cat)",
      "print(top_product)",
      "print(returning_share)"
    ],
