  "exercise": {
    "title": "متى يشتري العملاء؟",
    "prompt": [
      "اقرأ الملف مع تحويل `order_date` إلى تاريخ، ثم:"
    ],
    "requirements": [
      "`busiest_month`: رقم الشهر (1–12) الذي فيه أكبر عدد طلبات.",
      "`weekend_share`: نسبة الطلبات يومي الجمعة والسبت (`dayofweek` 4 و 5)، مقربة لثلاث منازل.",
      "`days_since`: عمود في `df` بعدد الأيام من تاريخ الطلب حتى `2025-12-31`.",
      "`last_30`: جدول بالطلبات التي `days_since` لها أقل من 30."
    ],
    "starter_code": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\", parse_dates=[\"order_date\"])",
      "",
      "# اكتب الحل هنا"
    ],
    "tests": [
      "import pandas as _pd",
      "_d = _pd.read_csv(\"store_sales.csv\", parse_dates=[\"order_date\"])",
      "assert busiest_month == _d[\"order_date\"].dt.month.value_counts().idxmax(), \"busiest_month غير صحيح\"",
      "assert weekend_share == round(float(_d[\"order_date\"].dt.dayofweek.isin([4, 5]).mean()), 3), \"weekend_share غير صحيحة\"",
      "_days = (_pd.Timestamp(\"2025-12-31\") - _d[\"order_date\"]).dt.days",
      "assert df[\"days_since\"].tolist() == _days.tolist(), \"days_since غير صحيح\"",
      "assert len(last_30) == int((_days < 30).sum()), f\"last_30 يجب أن يكون {int((_days < 30).sum())} صفاً\""
    ],
    "hints": [
      "`value_counts().idxmax()` على `dt.month`.",
      "`dt.dayofweek.isin([4, 5]).mean()` نسبة.",
      "`(pd.Timestamp(\"2025-12-31\") - df[\"order_date\"]).dt.days`."
    ],
    "solution": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\", parse_dates=[\"order_date\"])",
      "",
      "busiest_month = df[\"order_date\"].dt.month.value_counts().idxmax()",
      "weekend_share = round(float(df[\"order_date\"].dt.dayofweek.isin([4, 5]).mean()), 3)",
      "df[\"days_since\"] = (pd.Timestamp(\"2025-12-31\") - df[\"order_date\"]).dt.days",
      "last_30 = df[df[\"days_since\"] < 30]",
      "",
      "print(busiest_month, weekend_share, len(last_30))"
    ],
    "solution_explanation": [
      "`days_since` هي \"الحداثة\" Recency في تحليل RFM للعملاء، وستستخدمها في المشروع 4."
    ]
  },
