        "  {\"branch\": \"الرياض\", \"month\": \"2025-11\", \"revenue\": 61800}",
        "]'''",
        "branches = pd.read_json(io.StringIO(api_json))",
        "print(branches)",
        "",
        "branches.to_csv(\"branches.csv\", index=False)",
        "print(open(\"branches.csv\", encoding=\"utf-8\").read())",
        "",
        "print(branches.to_json(orient=\"records\", force_ascii=False))"
      ],
      "explanation": [
        {
          "code": "pd.read_json(io.StringIO(api_json))",
          "text": "قراءة JSON من نص (من ملف: `pd.read_json(\"file.json\")`). `io.StringIO` تجعل النص يتصرف كملف."
        },
        {
          "code": "to_csv(\"branches.csv\", index=False)",
          "text": "`index=False` لا يكتب الفهرس 0 و 1 كعمود إضافي."
        },
        {
          "code": "to_json(orient=\"records\", force_ascii=False)",
          "text": "قائمة سجلات مع الحروف العربية كما هي."
        }
      ],
      "expected_output": [
        "   branch    month  revenue",
        "0     جدة  2025-11    53225",
        "1  الرياض  2025-11    61800",
        "branch,month,revenue",
        "جدة,2025-11,53225",
        "الرياض,2025-11,61800",
        "",
        "[{\"branch\":\"جدة\",\"month\":\"2025-11\",\"revenue\":53225},{\"branch\":\"الرياض\",\"month\":\"2025-11\",\"revenue\":61800}]"
      ]
