    {
      "type": "example",
      "title": "الأنواع والتواريخ عند القراءة",
      "code": [
        "import pandas as pd",
        "",
        "df = pd.read_csv(",
        "    \"store_sales.csv\",",
        "    parse_dates=[\"order_date\"],",
        "    dtype={\"order_id\": \"string\", \"city\": \"category\"},",
        ")",
        "print(df.dtypes)",
        "print(df[\"order_date\"].min(), df[\"order_date\"].max())",
        "print(df[\"order_date\"].dt.month.head(3).tolist())"
      ],
      "explanation": [
        {
          "code": "parse_dates=[\"order_date\"]",
          "text": "العمود أصبح `datetime64` فنستطيع أخذ `min` و `max` واستخراج الشهر بـ `.dt.month`."
        },
        {
          "code": "\"order_id\": \"string\"",
          "text": "نوع نصوص مخصص في Pandas بدلاً من `object`."
        },
        {
          "code": "\"city\": \"category\"",
          "text": "نوع فئوي: موفر للذاكرة للأعمدة ذات القيم المتكررة. له درس في الوحدة القادمة."
        }
      ],
      "expected_output": [
        "order_id          string[python]",
        "order_date        datetime64[ns]",
        "city                    category",
        "category                  object",
        "product                   object",
        "unit_price                 int64",
        "quantity                   int64",
        "discount                 float64",
        "payment_method            object",
        "customer_type             object",
        "rating                   float64",
        "dtype: object",
        "2025-01-01 00:00:00 2025-12-31 00:00:00",
        "[1, 1, 1]"
      ]
    },
    {
      "type": "example",
      "title": "JSON والحفظ",
      "code": [
        "import io",
        "import pandas as pd",
        "",
        "api_json = '''[",
