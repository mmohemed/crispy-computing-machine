        "df[\"revenue\"] = df[\"unit_price\"] * df[\"quantity\"] * (1 - df[\"discount\"])",
        "",
        "df[\"city_avg\"] = df.groupby(\"city\")[\"revenue\"].transform(\"mean\")",
        "df[\"above_city_avg\"] = df[\"revenue\"] > df[\"city_avg\"]",
