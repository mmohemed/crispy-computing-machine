  "exercise": {
    "title": "بطاقة أداء المنتجات",
    "prompt": [
      "ابنِ جدول `report` لكل منتج بالتجميع المسمى، ثم أضف عموداً على `df`:"
    ],
    "requirements": [
      "أعمدة `report`: `orders` (عدد الطلبات)، و `units` (مجموع الكميات)، و `revenue` (مجموع الإيراد مقرباً لمنزلتين)، و `avg_rating` (متوسط التقييم مقرباً لمنزلتين).",
      "رتّب `report` تنازلياً حسب `revenue`.",
      "أضف إلى `df` عموداً `share_of_product` = إيراد الطلب ÷ إجمالي إيراد منتجه (باستخدام `transform`)."
    ],
    "starter_code": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\")",
      "df[\"revenue\"] = df[\"unit_price\"] * df[\"quantity\"] * (1 - df[\"discount\"])",
      "",
      "# اكتب الحل هنا"
    ],
    "tests": [
      "_g = df.groupby(\"product\")",
      "assert list(report.columns) == [\"orders\", \"units\", \"revenue\", \"avg_rating\"], f\"أعمدة report غير صحيحة: {list(report.columns)}\"",
      "assert report.index.tolist() == _g[\"revenue\"].sum().round(2).sort_values(ascending=False).index.tolist(), \"رتّب report حسب revenue تنازلياً\"",
      "assert report[\"units\"].to_dict() == _g[\"quantity\"].sum().to_dict(), \"units غير صحيحة\"",
      "assert report[\"revenue\"].to_dict() == _g[\"revenue\"].sum().round(2).to_dict(), \"revenue غير صحيحة\"",
      "assert report[\"avg_rating\"].to_dict() == _g[\"rating\"].mean().round(2).to_dict(), \"avg_rating غير صحيحة\"",
      "assert \"share_of_product\" in df.columns, \"أضف share_of_product إلى df\"",
      "assert abs(df.groupby(\"product\")[\"share_of_product\"].sum() - 1).max() < 1e-9, \"مجموع share_of_product لكل منتج يجب أن يكون 1\""
    ],
    "hints": [
      "`units=(\"quantity\", \"sum\")` داخل `agg`.",
      "`round(2)` بعد `agg`، ثم `sort_values(\"revenue\", ascending=False)`.",
      "`df.groupby(\"product\")[\"revenue\"].transform(\"sum\")` تعطي إجمالي المنتج أمام كل طلب."
    ],
    "solution": [
      "import pandas as pd",
      "",
      "df = pd.read_csv(\"store_sales.csv\")",
      "df[\"revenue\"] = df[\"unit_price\"] * df[\"quantity\"] * (1 - df[\"discount\"])",
      "",
      "report = df.groupby(\"product\").agg(",
      "    orders=(\"order_id\", \"count\"),",
      "    units=(\"quantity\", \"sum\"),",
      "    revenue=(\"revenue\", \"sum\"),",
      "    avg_rating=(\"rating\", \"mean\"),",
      ").round(2).sort_values(\"revenue\", ascending=False)",
      "",
      "df[\"share_of_product\"] = df[\"revenue\"] / df.groupby(\"product\")[\"revenue\"].transform(\"sum\")",
      "",
      "print(report.head())",
      "print(round(df.loc[df[\"product\"] == \"عسل سدر\", \"share_of_product\"].sum(), 6))"
    ],
    "solution_explanation": [
      "مجموع حصص طلبات أي منتج = 1، وهذا فحص سريع لصحة `transform`."
    ]
  },
