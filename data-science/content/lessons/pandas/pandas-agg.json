    {
      "type": "example",
      "title": "دالة تجميع خاصة",
      "code": [
        "import pandas as pd",
        "",
        "df = pd.read_csv(\"store_sales.csv\")",
        "df[\"revenue\"] = df[\"unit_price\"] * df[\"quantity\"] * (1 - df[\"discount\"])",
        "",
        "def price_range(s):",
        "    return s.max() - s.min()",
        "",
        "def share_rated(s):",
        "    return round(s.notna().mean() * 100, 1)",
        "",
        "result = df.groupby(\"category\").agg(",
        "    products=(\"product\", \"nunique\"),",
        "    price_range=(\"unit_price\", price_range),",
        "    rated_pct=(\"rating\", share_rated),",
        ")",
        "print(result)"
      ],
      "explanation": [
        {
          "code": "def price_range(s)",
          "text": "الدالة تستقبل Series المجموعة وترجع قيمة واحدة."
        },
        {
          "code": "share_rated",
          "text": "نسبة الطلبات التي قيّمها العملاء في كل فئة."
        },
        {
          "code": "(\"unit_price\", price_range)",
          "text": "نمرر الدالة نفسها (بدون أقواس) بدل اسم دالة جاهزة."
        }
      ],
      "expected_output": [
        "            products  price_range  rated_pct",
