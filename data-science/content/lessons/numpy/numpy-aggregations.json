      "    [420, 390, np.nan, 480, 470, 500],",
      "    [310, 330, 360, 400, 380, 410],",
      "    [200, 260, 240, 300, 310, 330],",
      "])",
      "",
      "# اكتب الحل هنا"
    ],
    "tests": [
      "import numpy as _np",
      "assert _np.allclose(branch_totals, [3800, 2260, 2190, 1640]), f\"branch_totals غير صحيحة: {branch_totals}\"",
