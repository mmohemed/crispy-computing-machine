      "assert list(best_month_per_branch) == [6, 6, 6, 6], f\"best_month_per_branch غير صحيحة: {best_month_per_branch}\"",
      "assert _np.array_equal(running, [540, 1150, 1730, 2430, 3080, 3800]), f\"running غير صحيحة: {running}\""
    ],
    "hints": [
      "قيمة لكل فرع = لكل صف = `axis=1`، وقيمة لكل شهر = `axis=0`.",
      "`np.nansum` و `np.nanmean` و `np.nanargmax` تتجاهل `NaN`.",
      "المواضع تبدأ من 0، فأضف 1 لرقم الشهر."
    ],
    "solution": [
      "import numpy as np",
      "",
      "branches = np.array([\"الرياض\", \"جدة\", \"الدمام\", \"أبها\"])",
      "sales = np.array([",
      "    [540, 610, 580, 700, 650, 720],",
      "    [420, 390, np.nan, 480, 470, 500],",
      "    [310, 330, 360, 400, 380, 410],",
      "    [200, 260, 240, 300, 310, 330],",
      "])",
      "",
      "branch_totals = np.nansum(sales, axis=1)",
      "month_avg = np.nanmean(sales, axis=0).round(1)",
      "best_branch = branches[branch_totals.argmax()]",
      "best_month_per_branch = np.nanargmax(sales, axis=1) + 1",
      "running = sales[0].cumsum()",
      "",
      "print(branch_totals, best_branch)",
      "print(month_avg)",
      "print(best_month_per_branch, running)"
    ]
