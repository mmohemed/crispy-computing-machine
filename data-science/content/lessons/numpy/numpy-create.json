  "exercise": {
    "title": "تجهيز مصفوفات لتحليل أسبوعي",
    "prompt": [
      "أنشئ المصفوفات التالية:"
    ],
    "requirements": [
      "`days`: الأرقام من 1 إلى 7 باستخدام `np.arange`.",
      "`targets`: مصفوفة طولها 7 كل قيمها 500 (هدف المبيعات اليومي) باستخدام `np.full`.",
      "`grid`: مصفوفة أصفار بشكل 4 فروع × 7 أيام من نوع أعداد صحيحة.",
      "`sim`: مبيعات محاكاة لسبعة أيام من التوزيع الطبيعي بمتوسط 500 وانحراف 80، باستخدام مولّد ببذرة 7، مقربة إلى أعداد صحيحة بـ `.round().astype(int)`."
    ],
    "starter_code": [
      "import numpy as np",
      "",
      "# اكتب الحل هنا"
    ],
    "tests": [
      "import numpy as _np",
      "assert _np.array_equal(days, _np.arange(1, 8)), f\"days غير صحيحة: {days}\"",
      "assert targets.shape == (7,) and (targets == 500).all(), \"targets يجب أن تكون 7 قيم كلها 500\"",
      "assert grid.shape == (4, 7) and (grid == 0).all() and grid.dtype.kind == \"i\", \"grid يجب أن تكون أصفاراً صحيحة بشكل (4, 7)\"",
      "_exp = _np.random.default_rng(7).normal(500, 80, 7).round().astype(int)",
      "assert _np.array_equal(sim, _exp), f\"sim غير صحيحة. تأكد من البذرة 7 والترتيب: {sim}\""
    ],
    "hints": [
      "`np.arange(1, 8)` لأن النهاية غير مشمولة.",
      "`np.zeros((4, 7), dtype=int)`: الشكل صف.",
      "`rng = np.random.default_rng(7)` ثم `rng.normal(500, 80, 7)`."
    ],
    "solution": [
      "import numpy as np",
      "",
      "days = np.arange(1, 8)",
      "targets = np.full(7, 500)",
      "grid = np.zeros((4, 7), dtype=int)",
      "rng = np.random.default_rng(7)",
      "sim = rng.normal(500, 80, 7).round().astype(int)",
      "",
      "print(days)",
      "print(sim)"
    ]
  },
