        "import pandas as pd",
        "",
        "df = pd.read_csv(\"store_sales.csv\")",
        "mask = (df[\"city\"] == \"جدة\") & (df[\"category\"] == \"أغذية\") & (df[\"discount\"] > 0)",
        "count = len(df[mask])",
        "print(count)"
