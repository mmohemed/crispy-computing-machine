        "_m = _d.merge(_p, on=\"product\", how=\"left\")",
        "_m[\"profit\"] = (_m[\"unit_price\"] * (1 - _m[\"discount\"]) - _m[\"unit_cost\"]) * _m[\"quantity\"]",
