        "import pandas as pd",
        "",
        "df = pd.read_csv(\"store_sales.csv\")",
        "products = pd.read_csv(\"products.csv\")[[\"product\", \"unit_cost\"]]",
        "",
        "m = df.merge(products, on=\"product\", how=\"left\")",
        "m[\"profit\"] = (m[\"unit_price\"] * (1 - m[\"discount\"]) - m[\"unit_cost\"]) * m[\"quantity\"]",
        "profit_by_cat = m.groupby(\"category\")[\"profit\"].sum()",
