/**
 * ينشئ استبيان «مدى الاستفادة من المكتبات والمصادر المفتوحة» على Google Forms تلقائياً،
 * ويربطه بجدول Google Sheets تُحفظ فيه الردود.
 *
 * طريقة الاستخدام:
 *   1. افتح https://script.google.com وأنشئ مشروعاً جديداً (New project).
 *   2. احذف الكود الموجود والصق هذا الملف كاملاً.
 *   3. اختر الدالة createLibrarySurvey من القائمة العلوية واضغط Run (تشغيل).
 *   4. وافق على الصلاحيات المطلوبة (Review permissions → Allow).
 *   5. افتح Execution log (سجل التنفيذ) وستجد فيه رابط النشر ورابط التعديل ورابط جدول الردود.
 */
function createLibrarySurvey() {
  var form = FormApp.create('استبيان: مدى الاستفادة من المكتبات والمصادر المفتوحة');
  form.setDescription(
    'عزيزي الطالب / عزيزتي الطالبة،\n' +
    'يهدف هذا الاستبيان إلى دراسة مدى استفادة طلاب الجامعة من المكتبة الجامعية والمصادر الرقمية المفتوحة، ' +
    'وذلك ضمن مشروع تطبيقي لمقرر «تحليل وعرض البيانات».\n' +
    'لا يستغرق الاستبيان أكثر من 5 دقائق، والإجابات سرّية وتُستخدم لأغراض علمية فقط. شكراً لتعاونكم.\n\n' +
    'إعداد الطالب: محمد عبدالإله عبدالله قريع'
  );
  form.setProgressBar(true);
  form.setCollectEmail(false);
  form.setConfirmationMessage('شكراً لمشاركتك، تم تسجيل إجابتك بنجاح.');

  // ---------- القسم الأول: البيانات الديموغرافية ----------
  form.addSectionHeaderItem().setTitle('القسم الأول: البيانات الديموغرافية');

  choice(form, '1. الجنس', ['ذكر', 'أنثى']);
  choice(form, '2. المستوى الدراسي', [
    'المستوى الأول', 'المستوى الثاني', 'المستوى الثالث', 'المستوى الرابع', 'المستوى الخامس فأعلى'
  ]);
  choice(form, '3. الكلية / مجال التخصص', [
    'الهندسة وتقنية المعلومات', 'الطب والعلوم الصحية', 'العلوم الإدارية والمالية',
    'العلوم الإنسانية والتربية', 'العلوم التطبيقية', 'أخرى'
  ]);
  choice(form, '4. المعدل التراكمي', ['ممتاز', 'جيد جداً', 'جيد', 'مقبول']);

  // ---------- القسم الثاني: المكتبة الجامعية ----------
  form.addPageBreakItem().setTitle('القسم الثاني: المكتبة الجامعية');

  choice(form, '5. كم مرة تزور المكتبة الجامعية عادةً؟', [
    'يومياً', 'عدة مرات في الأسبوع', 'مرة في الأسبوع', 'مرة في الشهر', 'نادراً', 'لا أزورها أبداً'
  ]);
  number(form, '6. كم ساعة تقضيها في المكتبة الجامعية أسبوعياً تقريباً؟', 0, 60);
  checkbox(form, '7. ما الأغراض الرئيسية لزيارتك للمكتبة؟ (يمكنك اختيار أكثر من إجابة)', [
    'استعارة الكتب والمراجع', 'المذاكرة في مكان هادئ', 'البحث عن مراجع للتكليفات والأبحاث',
    'استخدام الحواسيب أو الإنترنت', 'العمل الجماعي مع الزملاء', 'لا أزور المكتبة'
  ]);
  choice(form, '8. ما السبب الرئيسي الذي يحدّ من زيارتك للمكتبة؟', [
    'قلة المراجع الحديثة في تخصصي', 'عدم ملاءمة أوقات الدوام', 'ازدحام المكتبة أو عدم راحة المكان',
    'توفّر البديل الرقمي على الإنترنت', 'عدم معرفة طريقة البحث داخل المكتبة',
    'ضيق الوقت بسبب المحاضرات', 'لا يوجد ما يحدّ من زيارتي'
  ]);

  // ---------- القسم الثالث: المصادر الرقمية ----------
  form.addPageBreakItem().setTitle('القسم الثالث: المصادر الرقمية وقواعد البيانات المفتوحة');

  number(form, '9. كم ساعة تستخدم المصادر الرقمية لأغراض دراسية أسبوعياً تقريباً؟', 0, 80);
  checkbox(form, '10. ما المصادر الرقمية التي تستخدمها؟ (يمكنك اختيار أكثر من إجابة)', [
    'Google Scholar (الباحث العلمي)', 'ResearchGate', 'المكتبة الرقمية أو قواعد البيانات الخاصة بالجامعة',
    'قواعد البيانات العربية (مثل المنهل ودار المنظومة)', 'المكتبات الرقمية المفتوحة وكتب PDF المجانية',
    'ويكيبيديا', 'قنوات يوتيوب التعليمية', 'أدوات الذكاء الاصطناعي (مثل ChatGPT)'
  ]);
  choice(form, '11. على أي مصدر تعتمد أكثر في دراستك وأبحاثك؟', [
    'المكتبة الجامعية (الكتب الورقية) بشكل أساسي', 'المصادر الرقمية بشكل أساسي', 'كلاهما بالتساوي'
  ]);
  choice(form, '12. ما السبب الرئيسي لتفضيلك هذا المصدر؟', [
    'سهولة الوصول إليه في أي وقت', 'السرعة في الحصول على المعلومة', 'المجانية وعدم وجود تكلفة',
    'الموثوقية والدقة العلمية', 'حداثة المعلومات', 'توجيه أعضاء هيئة التدريس'
  ]);
  choice(form, '13. هل سبق أن تلقيت تدريباً على البحث في قواعد البيانات والمصادر العلمية؟', ['نعم', 'لا']);
  choice(form, '14. ما أكبر عائق يواجهك عند استخدام المصادر الرقمية؟', [
    'ضعف الإنترنت أو انقطاع الكهرباء', 'تكلفة باقات الإنترنت', 'صعوبة اللغة الإنجليزية في المصادر',
    'كون كثير من الأبحاث باشتراكات مدفوعة', 'صعوبة التمييز بين المصدر الموثوق وغير الموثوق', 'لا توجد عوائق'
  ]);

  // ---------- القسم الرابع: مقياس ليكرت ----------
  form.addPageBreakItem().setTitle('القسم الرابع: تقييم الاستفادة')
    .setHelpText('حدّد درجة موافقتك على كل عبارة من العبارات التالية.');

  form.addGridItem()
    .setTitle('15–23. درجة موافقتك على العبارات التالية')
    .setRows([
      '15. توفّر المكتبة الجامعية مراجع حديثة وكافية في تخصصي.',
      '16. أوقات دوام المكتبة مناسبة لجدولي الدراسي.',
      '17. بيئة المكتبة (الهدوء، الإضاءة، المقاعد) مريحة للمذاكرة.',
      '18. يساعدني موظفو المكتبة في الوصول إلى المراجع التي أحتاجها.',
      '19. أجد ما أحتاجه بسهولة في المصادر الرقمية المفتوحة.',
      '20. أثق في دقة المعلومات التي أحصل عليها من المصادر الرقمية.',
      '21. أغنتني المصادر الرقمية عن زيارة المكتبة الجامعية.',
      '22. أستطيع التمييز بين المصدر العلمي الموثوق وغير الموثوق.',
      '23. يساعدني استخدام المكتبة والمصادر المفتوحة على رفع مستواي الأكاديمي.'
    ])
    .setColumns(['أوافق بشدة', 'أوافق', 'محايد', 'لا أوافق', 'لا أوافق بشدة'])
    .setRequired(true);

  // ---------- القسم الخامس: التقييم العام ----------
  form.addPageBreakItem().setTitle('القسم الخامس: التقييم العام والمقترحات');

  form.addScaleItem()
    .setTitle('24. بشكل عام، كيف تقيّم مدى استفادتك من المكتبة الجامعية؟')
    .setBounds(1, 10)
    .setLabels('لا أستفيد إطلاقاً', 'أستفيد بدرجة كبيرة')
    .setRequired(true);

  form.addParagraphTextItem()
    .setTitle('25. ما مقترحاتك لتحسين الاستفادة من المكتبة الجامعية والمصادر الرقمية؟ (اختياري)')
    .setRequired(false);

  // ---------- ربط الردود بجدول Google Sheets ----------
  var sheet = SpreadsheetApp.create('ردود استبيان المكتبات والمصادر المفتوحة');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());

  Logger.log('رابط الاستبيان للنشر (أرسله للطلاب): ' + form.getPublishedUrl());
  Logger.log('رابط تعديل الاستبيان: ' + form.getEditUrl());
  Logger.log('رابط جدول الردود: ' + sheet.getUrl());
}

/** سؤال اختيار من متعدد (إجابة واحدة) وإجابته إلزامية. */
function choice(form, title, options) {
  return form.addMultipleChoiceItem().setTitle(title).setChoiceValues(options).setRequired(true);
}

/** سؤال مربعات اختيار (أكثر من إجابة) وإجابته إلزامية. */
function checkbox(form, title, options) {
  return form.addCheckboxItem().setTitle(title).setChoiceValues(options).setRequired(true);
}

/** سؤال إجابته رقم بين حدّين. */
function number(form, title, min, max) {
  var validation = FormApp.createTextValidation()
    .setHelpText('أدخل رقماً بين ' + min + ' و ' + max)
    .requireNumberBetween(min, max)
    .build();
  return form.addTextItem().setTitle(title).setValidation(validation).setRequired(true);
}
